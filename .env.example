# ==============================================================================
# Velox Viral — environment configuration
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials to any file.
#
#   cp .env.example .env.local
#
# The app boots with any subset of these. Features whose credentials are absent
# report "needs configuration" in the UI and activate automatically once the
# variables are supplied — nothing is stubbed or faked.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — Supabase (database + authentication + storage)
#
# Get these from your Supabase dashboard: Project Settings → API
# Without them the app renders a setup screen instead of a dashboard.
# ------------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://twfugnbquqyskpjxblcp.supabase.co

# "anon" / publishable key. Safe to expose to the browser — it is constrained by
# Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR3ZnVnbmJxdXF5c2twanhibGNwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MzQyMDEsImV4cCI6MjEwMzQxMDIwMX0._M-KCk_R_7wRHqzQH0DO4V7WfuyMoL04aahbCJoeoko

# "service_role" / secret key. BYPASSES Row Level Security.
# Server-side only. Never prefix this with NEXT_PUBLIC_ and never reference it
# from a client component.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR3ZnVnbmJxdXF5c2twanhibGNwIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzgzNDIwMSwiZXhwIjoyMTAzNDEwMjAxfQ.S6rX4myLNDmC62JcW0-8oxE7j_GiN1Gj202Xd24YR10


# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — Application URL
#
# Canonical origin used to build OAuth redirect URIs and auth email links. Must
# match the redirect URI registered with each social provider exactly.
# Local dev: http://localhost:3000
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://velox-viral-automation.vercel.app


# ------------------------------------------------------------------------------
# REQUIRED FOR SOCIAL CONNECTIONS — OAuth token encryption
#
# 32-byte key used to AES-256-GCM encrypt OAuth tokens at rest. Without it the
# app refuses to store social tokens rather than persisting them in plaintext,
# so "Connect account" stays disabled with an explanation.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating this key invalidates all stored tokens; users must reconnect.
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=


# ------------------------------------------------------------------------------
# AI CONTENT GENERATION — Google Gemini
#
# Get a key at https://aistudio.google.com/apikey
# Server-side only. The key is never sent to the browser; all generation runs
# through /api/ai/*. Without it the AI Studio surfaces a "configure Gemini"
# state instead of returning canned text.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------------------------
# SCHEDULED PUBLISHING — cron authentication
#
# Shared secret protecting /api/cron/*. On Vercel, Cron invocations are
# authenticated with this value; any external scheduler must send
# `Authorization: Bearer $CRON_SECRET`. Without it the cron routes refuse all
# requests, so scheduled posts will not publish.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
CRON_SECRET=


# ==============================================================================
# SOCIAL PLATFORM OAUTH CREDENTIALS
#
# Each platform is independent: configure only the ones you want live. An
# unconfigured platform shows a "Connect" button that explains which variables
# are missing, and starts working the moment they are set.
#
# Register this redirect URI with every provider (substitute your domain):
#   {NEXT_PUBLIC_APP_URL}/api/social/{platform}/callback
# e.g. http://localhost:3000/api/social/twitter/callback
# ==============================================================================

# --- X / Twitter -------------------------------------------------------------
# https://developer.x.com → Project → App → OAuth 2.0 settings
# Requires "Read and write" permissions and a Confidential Client.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn ----------------------------------------------------------------
# https://www.linkedin.com/developers/apps
# Requires the "Share on LinkedIn" and "Sign In with OpenID Connect" products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Facebook Pages ----------------------------------------------------------
# https://developers.facebook.com/apps → App settings → Basic
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Instagram (via Meta Graph API) ------------------------------------------
# Same Meta app as Facebook in most setups. Requires an Instagram
# Professional/Business account linked to a Facebook Page.
# You may reuse the Facebook values above.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- Threads -----------------------------------------------------------------
# https://developers.facebook.com → Threads API app
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# --- TikTok ------------------------------------------------------------------
# https://developers.tiktok.com → Manage apps → Content Posting API
# Note: TikTok calls the public identifier a "client key", not a client id.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube (Google Cloud OAuth) --------------------------------------------
# https://console.cloud.google.com → APIs & Services → Credentials
# Enable "YouTube Data API v3" and create an OAuth 2.0 Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ==============================================================================
# BILLING — Stripe (optional)
#
# Leave blank to run without billing: every account stays on the Free plan and
# upgrade buttons explain that billing is not configured. No fake checkout, no
# frontend-only "subscribed" state.
#
# Webhook endpoint: {NEXT_PUBLIC_APP_URL}/api/billing/webhook
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
